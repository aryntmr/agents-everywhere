# ---- Sponsor credentials (fill in .env, never commit) ----

# OpenAI (marquee sponsor) — key: https://platform.openai.com/api-keys
# Hackathon credits are 1,250 Codex credits (Codex only) — API calls still need your own key/billing
OPENAI_API_KEY=

# OpenRouter — OpenAI-compatible gateway, key: https://openrouter.ai/settings/keys
# Hackathon credit code: pending — emailed/DM'd when ready
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Exa — agent web search, key: https://dashboard.exa.ai/api-keys (shared offer via the Credits survey)
EXA_API_KEY=

# Auth0 for AI Agents — run `auth0 login`, then `auth0 apps create`
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Trigger.dev — durable agent tasks, key: https://cloud.trigger.dev (Project -> API keys)
TRIGGER_SECRET_KEY=

# Google Cloud Run — use a PERSONAL project, not the Vali work project
GCP_PROJECT_ID=
GCP_REGION=us-central1

# Ambiguous AI (prize: NVIDIA DGX Spark) — agent API key (ak_...) from provisioning an AI coworker
# The ambiguous CLI and .mcp.json read it from the SHELL env, not this file: set -a; source .env; set +a
AMBI_API_TOKEN=
AMBI_KEY_OPS=
AMBI_KEY_SAM=
AMBI_KEY_CARA=
AMBI_KEY_RAVI=
OPENAI_MODEL=
DEMO_GMAIL=
